{
  "name": "task_agent",
  "instructions": "Create drafts; require approval before simulated external actions.",
  "allowed_tools": [
    "create_draft",
    "send_email"
  ],
  "max_steps": 3,
  "model": {
    "provider": "mock",
    "model": "mock-deterministic",
    "temperature": 0.0,
    "max_output_tokens": 300
  },
  "mock_plan": [
    {
      "when": "send",
      "tool": "send_email",
      "arguments": {
        "to": "mentor@example.test",
        "subject": "Course update",
        "body": "{prompt}"
      }
    },
    {
      "tool": "create_draft",
      "arguments": {
        "subject": "Course update",
        "body": "{prompt}"
      }
    }
  ]
}
