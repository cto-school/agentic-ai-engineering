# api | local | mock
# api means the instructor-issued OpenRouter route and is the classroom default.
MODEL_MODE=api

# Local model configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=COURSE_MODEL_TO_BE_FINALIZED

# Optional hosted provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_MAX_OUTPUT_TOKENS=800
# Set these only after the instructor verifies current provider prices.
OPENROUTER_MAX_PROMPT_PRICE=
OPENROUTER_MAX_COMPLETION_PRICE=

# Optional direct OpenAI route, demonstrated completely in Day 1 Notebook 01
OPENAI_API_KEY=
# Use a chat model that is available on your own OpenAI account (see platform.openai.com/docs/models).
OPENAI_MODEL=

# Day 2: classroom uses local embeddings + Chroma + OpenRouter generation.
DAY2_MODE=classroom
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional hosted tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-ai-course
